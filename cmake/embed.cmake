file(GLOB files "${PROFILES_DIR}/*")
set(body "#include <stddef.h>\n#include \"core/builtin.h\"\n\n")
set(table "")
set(count 0)
foreach(f ${files})
    if(IS_DIRECTORY "${f}")
        continue()
    endif()
    get_filename_component(name "${f}" NAME)
    file(READ "${f}" hex HEX)
    string(LENGTH "${hex}" hex_len)
    math(EXPR size "${hex_len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND body "static const unsigned char profile_${count}[] = {${bytes}0};\n")
    string(APPEND table "    {\"${name}\", (const char *)profile_${count}, ${size}},\n")
    math(EXPR count "${count} + 1")
endforeach()
string(APPEND body "\nconst pb_builtin_t pb_builtin_profiles[] = {\n${table}    {NULL, NULL, 0},\n};\n")
file(WRITE "${OUTPUT}.tmp" "${body}")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
